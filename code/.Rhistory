png("../output/did_pop_iplot.png", width = 800, height = 600, res = 150)
iplot(did_pop, main = "Effect on Establishment Number\nTreatment = I (border county) * I (pop < median_pop)")
source("C:/document/SMU PhD/research/wayfair/code/cbp clean.R", echo = TRUE)
nevada = cbp_border %>%
filter(STATEFP == 32, is_boundary_county == 1) %>%
group_by(YEAR) %>%
summarise(sum = sum(ESTAB))
ggplot(data = nevada, aes(x = YEAR, y = sum))+
geom_point()
# combine population ----
pop = raw_pop
pop$NAME = str_remove(pop$NAME, "^\\.")
test = cbp_border %>%
left_join(pop %>% select(NAME, `2018pop`), by = "NAME") %>%
drop_na() %>%
mutate(small = ifelse(`2018pop` < median(`2018pop`), 1, 0)) %>%
mutate(treat_pop = treat*small)
did_pop = feols(
ESTAB~ i(time, treat_pop, ref = -1) | GEO_ID + YEAR,
data = test,
cluster = ~STATEFP
)
# export did parallel trend graph ----
png("../output/did_pop_iplot.png", width = 800, height = 600, res = 150)
iplot(did_pop, main = "Effect on Establishment Number\nTreatment = I (border county) * I (pop < median_pop)")
dev.off()
png("../output/did_iplot.png", width = 800, height = 600, res = 150)
iplot(did, main = "Effect on Establishment Number\nTreatment = I (border county)")
dev.off()
